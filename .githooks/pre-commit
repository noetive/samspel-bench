#!/bin/sh
# A pre-commit hook is a filter, not a second CI. Everything here is under a
# second on a warm cache, because a hook you wait on is a hook you pass
# --no-verify, and a bypassed hook enforces nothing. Tests and lint live in
# pre-push, where the frequency makes five seconds affordable.
#
# No `set -e`: every check runs even after one fails, so a bad commit costs one
# round of fixes instead of four.
#
# Credential, size and binary checks read the index, which is exactly what the
# commit captures. Formatting reads the working tree: closing that gap means
# `git stash --keep-index`, which costs a second and can eat work when the hook
# is interrupted, a worse trade than the hole it fills.
#
# A missing tool is announced, never silently skipped: a check that quietly
# stopped running is indistinguishable from one that passes.

fail=0

# core.quotePath=false because the default renders a non-ASCII path as an
# escaped, double-quoted string: `"sub/na\303\257ve.key"` matches neither the
# credential globs below nor `*.go`, and is not a path `git rev-parse` accepts.
# Every check downstream would pass on a file it never looked at.
#
# ACMR, not ACM: a rename is how a file arrives at a name the credential globs
# match, and dropping renames made a pure-rename commit skip every check here.
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# --- credentials, by path --------------------------------------------------
# .envrc.local holds per-developer credentials. .gitignore covers these
# already; `git add -f` does not care, and a public repository's history cannot
# be rewritten after a push.
while IFS= read -r path; do
	case "$path" in
	.env | .envrc.local | */.env | */.envrc.local | *.envrc.*.local | *.pem | *.key | *_rsa | *_ed25519)
		printf 'pre-commit: %s is a credential file and never belongs in a commit.\n' "$path" >&2
		fail=1
		;;
	esac
done <<STAGED
$staged
STAGED

# --- credentials, by content -----------------------------------------------
# Six known credential shapes, not a scanner. A broad entropy check produces
# false positives, and a hook that cries wolf is what trains the --no-verify
# reflex. The base58 charset and the 24-character floor keep short test
# fixtures from tripping the key pattern.
#
# The key family is matched as key<letter>_ rather than as a list of the
# families that exist today: a list goes stale silently, and a stale list is a
# guard reporting success for the one input it exists to catch. This is
# detection, not validation.
#
# The matching lines are counted, not echoed: printing them would copy the
# credential into terminal scrollback and any log capturing it.
leaked=$(git diff --cached -U0 --diff-filter=ACMR |
	grep '^+' |
	grep -Eac 'key[a-z]_[1-9A-HJ-NP-Za-km-z]{24,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|npm_[A-Za-z0-9]{36}|AKIA[0-9A-Z]{16}')
if [ "$leaked" -gt 0 ]; then
	printf 'pre-commit: %s staged line(s) match a live credential shape. Find them with `git diff --cached`.\n' "$leaked" >&2
	fail=1
fi

# --- binaries and bulk -----------------------------------------------------
# `make bench` leaves mem.out and `go test -c` leaves a multi-megabyte
# samspel.test. Both are gitignored and both are one `git add -f` from being
# permanent. The one binary tracked here is the results site's link-preview
# image, so PNGs directly under docs/ pass; the size cap above still holds them.
# Any other binary is a mistake.
while IFS= read -r path; do
	[ -n "$path" ] || continue
	blob=$(git rev-parse ":$path" 2>/dev/null)
	if [ -z "$blob" ]; then
		printf 'pre-commit: could not read the staged blob for %s, so its size went unchecked.\n' "$path" >&2
		fail=1
		continue
	fi
	size=$(git cat-file -s "$blob" 2>/dev/null)
	if [ "$size" -gt 524288 ]; then
		printf 'pre-commit: %s is %s bytes. Nothing that size belongs in history.\n' "$path" "$size" >&2
		fail=1
	fi
done <<STAGED
$staged
STAGED

# Renames are listed as a delete plus an add, so the path judged is always the
# new one, and fields split on tabs so a path with spaces stays whole.
binaries=$(git -c core.quotePath=false diff --cached --numstat --no-renames --diff-filter=ACMR |
	awk -F '\t' '$1 == "-" && $2 == "-" && $3 !~ /^docs\/[^\/]*\.png$/ { print $3 }')
if [ -n "$binaries" ]; then
	printf 'pre-commit: only PNGs directly under docs/ may be binary, but these are staged:\n%s\n' "$binaries" >&2
	fail=1
fi

# --- formatting ------------------------------------------------------------
# `golangci-lint fmt` runs exactly the gofmt+goimports pair .golangci.yml
# configures, so what passes here passes CI. Emptiness of the diff decides, not
# exit status: the two have disagreed across releases.
go_staged=$(printf '%s\n' "$staged" | grep '\.go$')
if [ -n "$go_staged" ]; then
	if command -v golangci-lint >/dev/null 2>&1; then
		drift=$(golangci-lint fmt --diff --config ./.golangci.yml 2>&1)
		if [ -n "$drift" ]; then
			printf 'pre-commit: formatting drift. Run `golangci-lint fmt` and stage the result.\n%s\n' "$drift" >&2
			fail=1
		fi
	elif command -v gofmt >/dev/null 2>&1; then
		printf 'pre-commit: DEGRADED formatting: golangci-lint is absent, so import grouping goes unchecked this commit (go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.5.0).\n' >&2
		while IFS= read -r path; do
			[ -f "$path" ] || continue
			if [ -n "$(gofmt -l "$path")" ]; then
				printf 'pre-commit: gofmt would rewrite %s.\n' "$path" >&2
				fail=1
			fi
		done <<GOFILES
$go_staged
GOFILES
	else
		# Not an optional tool: this commit changes Go source.
		printf 'pre-commit: neither golangci-lint nor gofmt is on PATH and this commit changes Go source.\n' >&2
		fail=1
	fi
fi

exit $fail
